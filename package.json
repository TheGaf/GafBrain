{
  "name": "gafbrain",
  "version": "3.2.0-alpha",
  "description": "Personal knowledge compiler for AI. Compile your accumulated knowledge into a private, portable Brain.",
  "type": "module",
  "scripts": {
    "init": "node app/Compiler/init-archive.js",
    "compile:chatgpt": "node app/Compiler/compile-chatgpt.js",
    "master-index": "node app/Compiler/master-index.js",
    "summary": "node app/Compiler/summary.js",
    "search": "node app/Compiler/search.js",
    "recall": "node app/Compiler/recall.js",
    "context": "node app/Compiler/context-pack.js",
    "brief": "node app/Compiler/brief.js",
    "ask": "node app/Compiler/ask.js",
    "timeline": "node app/Compiler/timeline.js",
    "history": "node app/Compiler/history.js",
    "projects": "node app/Compiler/project-index.js",
    "session:log": "node app/Compiler/session-log.js",
    "brain:status": "node app/Compiler/brain-status.js",
    "all": "npm run init && npm run compile:chatgpt && npm run master-index && npm run summary",
    "build": "npm run all && npm run doctor",
    "doctor": "node app/Compiler/doctor.js",
    "catalog:files": "node app/Compiler/compile-files.js",
    "build:files": "npm run catalog:files"
  },
  "dependencies": {}
}
